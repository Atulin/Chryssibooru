<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen matches the app's dark surface colour and shows
     the logo centred, so there is no white flashbang on startup. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:drawable="@drawable/launch_logo"
        android:gravity="center" />
</layer-list>
